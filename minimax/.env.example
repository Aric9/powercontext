# Copy to .env and export before running the live MiniMax step.
# Never commit real credentials.
MINIMAX_API_KEY=replace-me
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# Optional overrides
# SDD_DATA_DIR=/absolute/path/to/.sdd
# SDD_EMBED_DIM=512
# POWERCONTEXT_URL=http://127.0.0.1:8791
# SDD_POWERCONTEXT_SCOPE=sdd-refund
